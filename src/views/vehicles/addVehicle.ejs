<%- include('../partials/header') %>

<main class="vehicle-form">

    <h1><%= title %></h1>

    <form action="/vehicles/new" method="POST">

        <div class="form-group">
            <label for="make">Make</label>
            <input type="text" id="make" name="make" required>
        </div>

        <div class="form-group">
            <label for="model">Model</label>
            <input type="text" id="model" name="model" required>
        </div>

        <div class="form-group">
            <label for="year">Year</label>
            <input type="number" id="year" name="year" min="1900" max="2100" required>
        </div>

        <div class="form-group">
            <label for="price">Price</label>
            <input type="number" id="price" name="price" step="0.01" min="0" required>
        </div>

        <div class="form-group">
            <label for="mileage">Mileage</label>
            <input type="number" id="mileage" name="mileage" min="0" required>
        </div>

        <div class="form-group">
            <label for="categoryId">Category</label>
            <select id="categoryId" name="categoryId" required>
                <% categories.forEach(category => { %>
                    <option value="<%= category.category_id %>">
                        <%= category.name %>
                    </option>
                <% }); %>
            </select>
        </div>

        <div class="form-group">
            <label for="transmission">Transmission</label>
            <input type="text" id="transmission" name="transmission" required>
        </div>

        <div class="form-group">
            <label for="drivetrain">Drivetrain</label>
            <input type="text" id="drivetrain" name="drivetrain" required>
        </div>

        <div class="form-group">
            <label for="fuelType">Fuel Type</label>
            <input type="text" id="fuelType" name="fuelType" required>
        </div>

        <div class="form-group">
            <label for="engine">Engine</label>
            <input type="text" id="engine" name="engine" required>
        </div>

        <div class="form-group">
            <label for="horsepower">Horsepower</label>
            <input type="number" id="horsepower" name="horsepower" min="1">
        </div>

        <div class="form-group">
            <label for="exteriorColor">Exterior Color</label>
            <input type="text" id="exteriorColor" name="exteriorColor" required>
        </div>

        <div class="form-group">
            <label for="interiorColor">Interior Color</label>
            <input type="text" id="interiorColor" name="interiorColor" required>
        </div>

        <div class="form-group">
            <label for="vin">VIN</label>
            <input type="text" id="vin" name="vin" required>
        </div>

        <div class="form-group">
            <label for="stockNumber">Stock Number</label>
            <input type="text" id="stockNumber" name="stockNumber" required>
        </div>

        <div class="form-group full-width">
            <label for="description">Description</label>
            <textarea id="description" name="description" rows="6" required></textarea>
        </div>

        <div class="form-group">
            <label for="availability">Availability</label>
            <select id="availability" name="availability" required>
                <option value="true">Available</option>
                <option value="false">Unavailable</option>
            </select>
        </div>

        <div class="form-group">
            <label for="featured">Featured Vehicle</label>
            <select id="featured" name="featured" required>
                <option value="false">No</option>
                <option value="true">Yes</option>
            </select>
        </div>

        <div class="form-group full-width">
            <label for="frontImageUrl">Front Image URL</label>
            <input type="text" id="frontImageUrl" name="frontImageUrl" required>
        </div>

        <div class="form-group full-width">
            <label for="sideImageUrl">Side Image URL</label>
            <input type="text" id="sideImageUrl" name="sideImageUrl" required>
        </div>

        <div class="form-group full-width">
            <label for="interiorImageUrl">Interior Image URL</label>
            <input type="text" id="interiorImageUrl" name="interiorImageUrl" required>
        </div>

        <button type="submit">Add Vehicle</button>

        <a href="/vehicles" class="buttonCancel">
            Cancel
        </a>

    </form>

</main>

<%- include('../partials/footer') %>