<%- include('partials/header') %>
<main>
    <div class="hero">
        <h1>FIND YOUR NEXT VEHICLE</h1>
    </div>
</main>
<body>
    <div class="featureVehiclesSection">
            <h2>Featured Vehicles</h2>
            <div class="FeaturedVehiclesContainer">
                <% featuredVehicles.forEach(vehicle => { %>
                    <div class="featureVehicleCard">
                        <img src="<%= vehicle.image_url %>" alt="<%= vehicle.make %> <%= vehicle.model %>">
                        <h3 class="carName"><%= vehicle.make %> <%= vehicle.model %></h3>
                        <h4>$<%= vehicle.price %></h4>
                        <p class="mileage"><%= vehicle.mileage %> miles</p>
                        <p class="category"><%= vehicle.category_name %></p>
                        <p class="transmission"><%= vehicle.transmission %></p>
                        <button>Details</button>
                    </div>
               <% }); %>
            </div>
    </div>        
</body>
<%- include('partials/footer') %>