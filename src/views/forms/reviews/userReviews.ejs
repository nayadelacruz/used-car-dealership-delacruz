<%- include('../../partials/header') %>

<main class="userReviews">

    <h1><%= title %></h1>

    <% if (reviews.length === 0) { %>

        <p>You haven't submitted any reviews yet.</p>

    <% } else { %>

        <table class="reviewsTable">

            <thead>
                <tr>
                    <th>Vehicle</th>
                    <th>Review</th>
                    <th>Date</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>

                <% reviews.forEach(review => { %>

                    <tr>

                        <td>
                            <%= review.year %> <%= review.make %> <%= review.model %>
                        </td>

                        <td>
                            <%= review.comment %>
                        </td>

                        <td>
                            <%= new Date(review.created_at).toLocaleDateString() %>
                        </td>

                        <td>

                            <a
                                href="/reviews/edit/<%= review.review_id %>"
                                class="bottonEdit">
                                Edit
                            </a>

                            <form
                                action="/reviews/delete/<%= review.review_id %>"
                                method="POST"
                                style="display:inline;">

                                <button
                                    type="submit"
                                    class="bottonDelete"
                                    onclick="return confirm('Are you sure you want to delete this review?')">
                                    Delete
                                </button>

                            </form>

                        </td>

                    </tr>

                <% }); %>

            </tbody>

        </table>

    <% } %>

</main>

<%- include('../../partials/footer') %>