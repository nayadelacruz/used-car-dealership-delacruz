<%- include('../../partials/header') %>

<main class="category-form">
    <h1><%= title %></h1>

    <form action="/categories/<%= category.category_id %>/edit" method="POST">
        <div class="form-group">
            <label for="name">Category Name</label>
            <input
                type="text"
                id="name"
                name="name"
                value="<%= category.name %>"
                required>
        </div>

        <button type="submit">Save Changes</button>

        <a href="/categories/manage" class="buttonCancel">
            Cancel
        </a>
    </form>
</main>

<%- include('../../partials/footer') %>