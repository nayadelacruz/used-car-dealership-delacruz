<%- include('../../partials/header') %>

<main>

    <div class="review-container">

        <h1><%= title %></h1>

        <form
            class="review-form"
            action="/reviews/edit/<%= review.review_id %>"
            method="POST">

            <label for="comment">
                Review
            </label>

            <textarea
                id="comment"
                name="comment"
                rows="6"
                required
                minlength="5"
                maxlength="1000"><%= review.comment %></textarea>

            <button type="submit">
                Save Changes
            </button>

        </form>

        <a
            href="/reviews/myReviews"
            class="back-link">

            ← Back to My Reviews

        </a>

    </div>

</main>

<%- include('../../partials/footer') %>